# MATEO-FMB Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# Facebook Login
# ====================
FACEBOOK_APPSTATE=[]

# ====================
# Bot Owner
# ====================
BOT_OWNER_ID=

# ====================
# Bot Configuration
# ====================
BOT_PREFIX=/
BOT_NAME=MATEO-FMB
BOT_LANGUAGE=en

# ====================
# Database
# ====================
DB_TYPE=json
DB_PATH=./data/mateo.db

# ====================
# Logging
# ====================
LOG_LEVEL=info
LOG_COLORS=true

# ====================
# AI Provider (Optional)
# ====================
AI_PROVIDER=none
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# ====================
# Advanced
# ====================
AUTO_RESTART_INTERVAL=60
CONNECTION_TIMEOUT=30000
MAX_QUEUE_SIZE=1000
